<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_native_print" model="res.groups.privilege">
        <field name="name">Yaseir Print</field>
    </record>
    <record id="group_native_print_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_native_print"/>
    </record>
    <record id="group_native_print_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_native_print"/>
        <field name="implied_ids" eval="[Command.link(ref('group_native_print_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
    <!-- Grant administrators Yaseir Print / Manager by default -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_native_print_manager'))]"/>
    </record>
    <!-- Grant internal users Yaseir Print / User by default so standard Odoo users
         can print natively and see the print job log out of the box -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_native_print_user'))]"/>
    </record>
</odoo>
