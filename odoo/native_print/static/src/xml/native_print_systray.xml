<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="native_print.SystrayItem">
        <div class="o_mail_systray_item dropdown o_native_print_systray" t-att-class="{'show': state.isOpen}">
            <button type="button"
                    class="dropdown-toggle o-no-caret btn d-flex align-items-center px-2"
                    t-att-title="labels.title"
                    t-on-click.stop="toggleMenu">
                <i class="fa fa-print fa-lg" role="img" aria-label="Yaseir Print"/>
                <span t-if="state.failedJobs &gt; 0"
                      class="badge rounded-pill text-bg-danger ms-1"
                      t-esc="state.failedJobs"/>
                <span t-elif="state.bridgeActive"
                      class="o_native_print_dot o_native_print_dot_online ms-1"/>
                <span t-else=""
                      class="o_native_print_dot o_native_print_dot_browser ms-1"/>
            </button>

            <div t-if="state.isOpen"
                 class="dropdown-menu dropdown-menu-end show shadow o_native_print_dropdown"
                 t-on-click.stop="">
                <!-- Header: brand tile + name + mode pill -->
                <div class="np-head">
                    <div class="np-brand-tile"><i class="fa fa-print"/></div>
                    <div class="np-head-text">
                        <div class="np-brand-name">Yaseir Print</div>
                        <div class="np-head-sub" t-esc="state.bridgeActive ? labels.appActive : labels.browserMode"/>
                    </div>
                    <span t-if="state.bridgeActive" class="badge rounded-pill text-bg-success np-mode-pill">
                        <i class="fa fa-check-circle me-1"/><t t-esc="labels.appActive"/>
                    </span>
                    <span t-else="" class="badge rounded-pill text-bg-secondary np-mode-pill">
                        <i class="fa fa-globe me-1"/><t t-esc="labels.browserMode"/>
                    </span>
                </div>

                <!-- Browser mode explainer -->
                <div t-if="!state.bridgeActive" class="np-info-box" dir="auto">
                    <i class="fa fa-info-circle np-info-icon"/>
                    <span t-esc="labels.browserNote"/>
                </div>

                <!-- Desktop app update notice (bridge older than this panel) -->
                <div t-if="state.appOutdated" class="np-info-box" dir="auto">
                    <i class="fa fa-arrow-circle-up np-info-icon"/>
                    <span t-esc="labels.updateApp"/>
                </div>

                <!-- App mode: this PC's printers summary -->
                <div t-if="state.bridgeActive" class="np-info-box np-info-rows">
                    <div class="np-info-row">
                        <i class="fa fa-print np-info-icon"/>
                        <span class="np-info-label" t-esc="labels.localPrinters"/>
                        <strong class="np-info-value" t-esc="state.printersCount"/>
                    </div>
                    <div t-if="state.defaultPrinter" class="np-info-row">
                        <i class="fa fa-star np-info-icon"/>
                        <span class="np-info-label" t-esc="labels.defaultPrinter"/>
                        <strong class="np-info-value text-truncate" dir="auto" t-esc="state.defaultPrinter"/>
                    </div>
                </div>

                <!-- App mode: live printer picker -->
                <div t-if="state.bridgeActive and state.discoveredPrinters.length" class="np-printer-list">
                    <t t-foreach="state.discoveredPrinters" t-as="printer" t-key="printer.name">
                        <div class="np-printer-row">
                            <span class="np-printer-name" dir="auto" t-esc="printer.name"/>
                            <span t-if="state.selectedPrinter === printer.name || (!state.selectedPrinter &amp;&amp; state.defaultPrinter === printer.name)" class="badge rounded-pill text-bg-primary np-inuse-pill">
                                <i class="fa fa-star me-1"/><t t-esc="labels.inUse"/>
                            </span>
                            <button t-else="" type="button" class="btn btn-sm btn-link np-use-btn"
                                    t-on-click="() => this.selectPrinter(printer)">
                                <t t-esc="labels.usePrinter"/>
                            </button>
                        </div>
                    </t>
                </div>

                <button t-if="state.bridgeActive" type="button"
                        class="btn btn-sm btn-outline-secondary w-100 np-refresh-btn"
                        t-on-click="refreshPrinters" t-att-disabled="state.syncingPrinters">
                    <i t-att-class="state.syncingPrinters ? 'fa fa-spinner fa-spin me-2' : 'fa fa-refresh me-2'"/>
                    <t t-if="state.syncingPrinters"><t t-esc="labels.discovering"/></t>
                    <t t-else=""><t t-esc="labels.refreshPrinters"/> (<t t-esc="state.printersCount"/>)</t>
                </button>

                <!-- Job counters -->
                <div class="np-stats">
                    <div class="np-stat">
                        <div class="np-stat-num"><span class="np-dot np-dot-active"/><t t-esc="state.activeJobs"/></div>
                        <div class="np-stat-label" t-esc="labels.activeJobs"/>
                    </div>
                    <div class="np-stat">
                        <div class="np-stat-num"><span class="np-dot np-dot-done"/><t t-esc="state.doneJobs"/></div>
                        <div class="np-stat-label" t-esc="labels.doneJobs"/>
                    </div>
                    <div class="np-stat" t-att-class="{'np-stat-alert': state.failedJobs &gt; 0}">
                        <div class="np-stat-num"><span class="np-dot np-dot-failed"/><t t-esc="state.failedJobs"/></div>
                        <div class="np-stat-label" t-esc="labels.failedJobs"/>
                    </div>
                </div>

                <!-- Actions -->
                <div class="np-actions">
                    <button type="button" class="btn btn-sm btn-primary w-100 np-primary-action" t-on-click="openJobs">
                        <i class="fa fa-list-ul me-2"/><t t-esc="labels.jobsLog"/>
                    </button>
                    <div t-if="state.bridgeActive" class="np-action-row">
                        <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="runQuickTestPrint">
                            <i class="fa fa-check-square-o me-1"/><t t-esc="labels.testPrint"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="openControlCenter">
                            <i class="fa fa-sliders me-1"/><t t-esc="labels.controlCenter"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
