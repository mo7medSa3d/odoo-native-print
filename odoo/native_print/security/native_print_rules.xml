<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_job_company" model="ir.rule">
        <field name="name">Native Print jobs: company</field>
        <field name="model_id" ref="model_native_print_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_job_user_own" model="ir.rule">
        <field name="name">Native Print jobs: user own</field>
        <field name="model_id" ref="model_native_print_job"/>
        <field name="groups" eval="[(4, ref('group_native_print_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_job_manager_company" model="ir.rule">
        <field name="name">Native Print jobs: manager company</field>
        <field name="model_id" ref="model_native_print_job"/>
        <field name="groups" eval="[(4, ref('group_native_print_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_device_company" model="ir.rule">
        <field name="name">Native Print printers: company</field>
        <field name="model_id" ref="model_native_print_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
