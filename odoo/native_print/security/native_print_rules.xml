<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rules: users only see their own companies'
         profiles, rules, and jobs. -->
    <record id="rule_profile_company" model="ir.rule">
        <field name="name">Native Print profiles: company</field>
        <field name="model_id" ref="model_native_print_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rule_company" model="ir.rule">
        <field name="name">Native Print rules: company</field>
        <field name="model_id" ref="model_native_print_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_job_company" model="ir.rule">
        <field name="name">Native Print jobs: company</field>
        <field name="model_id" ref="model_native_print_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
