<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0" schemaVersion="1.0"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Odoo Native Print</displayName>
  <description>Administrative templates for the Odoo Native Print client.</description>
  <resources>
    <stringTable>
      <string id="ONP_Category">Odoo Native Print</string>
      <string id="OdooOrigin">Odoo origin URL</string>
      <string id="OdooOrigin_Explain">The exact HTTPS origin of the company Odoo server, for example https://odoo.company.local:8069. The app is locked to this origin: it loads only this site and accepts print commands only from it. Set by IT; end users cannot change it when DisableOriginChange is also enabled.</string>
      <string id="DisableOriginChange">Lock the Odoo origin</string>
      <string id="DisableOriginChange_Explain">When enabled, the app reads its Odoo origin only from machine policy/install configuration and ignores per-user changes.</string>
    </stringTable>
    <presentationTable>
      <presentation id="OdooOrigin">
        <textBox refId="OdooOriginValue"><label>Odoo origin (HTTPS)</label></textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
