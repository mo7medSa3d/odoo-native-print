{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null,
      "devCsp": null,
      "freezePrototype": false
    },
    "windows": [],
    "withGlobalTauri": false
  },
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": {
      "resources/pdfium.dll": "pdfium.dll",
      "resources/pdfium-LICENSE.txt": "pdfium-LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "identifier": "com.company.odoo-native-print",
  "productName": "Yaseir Print",
  "version": "1.5.2"
}
