# Odoo Native Print — Environment Configuration Example
# Copy to `.env` for local development or Docker runs (`.env` is gitignored).
# NEVER commit real passwords, tokens, or signing certificates.

# Odoo (19.0 / 20.0) & PostgreSQL (Docker / Server Deployment)
# Build args for Dockerfile.odoo (use 20.0 and odoo20/native_print for Odoo 20).
ODOO_VERSION=19.0
ADDON_SRC=odoo/native_print

# Host port exposed for the Odoo HTTP service (container listens on 8069).
ODOO_PORT=8069

# Odoo container database connection settings.
HOST=db
PORT=5432
USER=odoo
PASSWORD=change-me-in-production

# PostgreSQL 16+ container bootstrap settings.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-in-production

# Desktop Client — Development Overrides Only
# In production, configure the Odoo origin via Windows GPO
# (HKLM\Software\Policies\OdooNativePrint\OdooOrigin) or per-user
# %APPDATA%\OdooNativePrint\config.json. Do NOT set these in production.
NATIVE_PRINT_ODOO_ORIGIN=https://erp.example.com
NATIVE_PRINT_PDFIUM_PATH=

# CI & Automated Testing
PDFIUM_TEST_REQUIRED=1
CARGO_TERM_COLOR=always

# Release Signing & Printer Lab (GitHub Actions Secrets / Workflow Inputs)
# Configure these in GitHub Repository Secrets — never in a workstation `.env`.
WINDOWS_CERTIFICATE_BASE64=
WINDOWS_CERTIFICATE_PASSWORD=
THERMAL_PRINTER=
LABEL_PRINTER=
OFFICE_PRINTER=
